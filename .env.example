# Vercel Postgres injects POSTGRES_URL and friends automatically once you
# attach a database in the Vercel dashboard (Storage tab). Nothing to set
# here manually in production -- this file is only for local `vercel dev`.

JWT_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin52
ADMIN_PASSWORD=admin53

# Origin of the GitHub Pages frontend, used for CORS. Example:
# https://ljwebmanagement.github.io
FRONTEND_ORIGIN=*

# Optional -- leave unset until Stripe is ready. The fee-payment page will
# show a "not enabled yet" message until these are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
